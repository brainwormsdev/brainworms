PORT=3000
# Behind Render / Railway / Fly / Cloudflare:
TRUST_PROXY=1
# Enables /admin endpoints. Use a long random string.
ADMIN_TOKEN=
# e.g. https://worm.example.com
ALLOWED_ORIGINS=
# Optional header
SITE_TICKER=
SITE_CONTRACT=
SITE_LINKS=
# Limits
MSG_PER_MIN=12
POKES_PER_SEC=3
MAX_QUEUE=12
MAX_CONN_PER_IP=8
FEED_SIZE=40
LOG_DIR=var
